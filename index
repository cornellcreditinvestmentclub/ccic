<script>
  const membersData = {"anika": {"role": "CO-FOUNDER & CO-PRESIDENT", "bio": "Anika is a senior studying Applied Economics and Management from Staten Island, NY. On campus, she is the New Member Educator for South Asian Business Association and a Dyson Finance Career Catalyst Coach, and is involved in Cayuga Capital, Impact Investing, and Women in Poker. Previously, she interned in Sourcing and Origination at Oaktree. This past summer, she was a Summer Analyst at Audax Private Debt, where she will be returning full-time. In her free time, she plays tennis and poker, and enjoys trying new restaurants and going to DJ shows."}, "sahil": {"role": "CO-FOUNDER & CO-PRESIDENT", "bio": "Sahil is a senior from New Jersey majoring in Applied Economics and Management. On campus, he is the Fintech Sector lead for Diversity on the Street and is actively involved with Cornell Investment Banking Club, Alpha Fund, South Asian Business Association, and Cornell Fintech Club. Previously, he worked as a Summer Analyst at Cornell's Investment Office. This past summer, he worked as a Private Credit Summer Analyst at Bain Capital, where he will be returning full-time. Sahil is passionate about community service, enjoys playing basketball and soccer, and loves watching movies and his favorite football team, the New York Giants."}, "vansh": {"role": "CO-PRESIDENT", "bio": "Vansh is a senior studying Applied Economics and Management and Information Science from Mumbai, India. On campus, he is involved in Cornell Finance Club, South Asian Business Association, Cornell Investment Banking Club, and Impact Investing. This past summer, he worked as a Private Credit Summer Analyst at Ares Management. In his free time, he enjoys working out and following Substack and startups."}, "angela": {"role": "CO-FOUNDER & CO-VP", "bio": "Angela is a junior studying Information Science. On campus, she is the VP of External Relations for Diversity on the Street, and is involved in Alpha Fund and Banking at Cornell. This upcoming summer, she will be a Summer Analyst at Blackstone."}, "riya": {"role": "CO-VP", "bio": "Riya is a junior studying Applied Economics and Management. On campus, she is involved in Banking at Cornell, Cornell Alternative Investments, Dyson Ambassadors, and the Dyson Undergraduate Council. She also serves as a course assistant for AEM 2700: Management Communication. She previously interned at BankUnited as a Summer Analyst and Incedo as an AI Product Summer Intern. This upcoming summer, she will be joining Brinley Partners as a Private Credit Summer Analyst."}};
  function showMember(id) {
    const m = membersData[id];
    const avatarImg = document.querySelector('#avatar-' + id + ' img');
    const cardName = document.querySelector('#avatar-' + id).parentElement.querySelector('.name').textContent;
    const photoClass = id === 'riya' ? 'riya-photo' : id === 'anika' ? 'anika-photo' : id === 'angela' ? 'angela-photo' : '';
    document.getElementById('detail-avatar').innerHTML = '<img src="' + avatarImg.src + '" alt="' + cardName + '" class="' + photoClass + '">';
    document.getElementById('detail-name').textContent = cardName;
    document.getElementById('detail-role').textContent = m.role;
    document.getElementById('detail-bio').textContent = m.bio;
    document.getElementById('team-grid').style.display = 'none';
    document.getElementById('member-detail').style.display = 'block';
    document.getElementById('team').scrollIntoView({behavior: 'smooth', block: 'start'});
  }
  function hideMember() {
    document.getElementById('member-detail').style.display = 'none';
    document.getElementById('team-grid').style.display = 'grid';
    document.getElementById('team').scrollIntoView({behavior: 'smooth', block: 'start'});
  }
</script>
</body>
</html>
