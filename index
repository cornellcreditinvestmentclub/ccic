<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>Cornell Credit Investment Club</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #FFFFFF;
    --paper-dim: #FAF3F4;
    --ink: #2B2429;
    --ink-soft: #7A6B70;
    --oxblood: #7C2340;
    --oxblood-dark: #5C1930;
    --rule: #EBDBDF;
    --rule-dark: #D8BFC6;
    --max-w: 1080px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: #FFFFFF; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--oxblood); color: var(--paper); }
  a { color: inherit; }
  img { max-width: 100%; display: block; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
  .wrap { max-width: var(--max-w); margin: 0 auto; padding: 0 32px; }
  .narrow { max-width: 760px; }

  /* ---------- Header ---------- */
  header {
    border-bottom: 1px solid var(--rule);
    position: sticky;
    top: 0;
    background: rgba(255,255,255,0.94);
    backdrop-filter: blur(6px);
    z-index: 10;
  }
  .header-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 20px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand {
    font-family: 'Source Serif 4', serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--ink);
  }
  nav { display: flex; gap: 30px; font-size: 0.92rem; }
  nav a {
    text-decoration: none;
    color: var(--ink-soft);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  nav a:hover { color: var(--oxblood); border-color: var(--oxblood); }
  nav a.apply {
    color: var(--paper);
    background: var(--oxblood);
    padding: 8px 16px;
    border-bottom: none;
  }
  nav a.apply:hover { background: var(--oxblood-dark); }
  @media (max-width: 640px) { nav a:not(.apply) { display: none; } }

  /* ---------- Hero ---------- */
  .hero { padding: 30px 0 0; }
  .hero-copy { padding: 30px 0 40px; text-align: center; }
  .hero .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.82rem;
    color: var(--oxblood);
    margin-bottom: 18px;
  }
  h1 {
    font-family: 'Source Serif 4', serif;
    font-weight: 500;
    font-size: clamp(2.3rem, 6vw, 3.6rem);
    line-height: 1.1;
    margin: 0 auto 22px;
    max-width: 16ch;
  }
  .hero p.lede {
    font-size: 1.12rem;
    color: var(--ink-soft);
    max-width: 52ch;
    margin: 0 auto 34px;
  }
  .hero-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

  .btn {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.88rem;
    text-decoration: none;
    padding: 13px 24px;
    border: 1px solid var(--oxblood);
  }
  .btn-solid { background: var(--oxblood); color: var(--paper); }
  .btn-solid:hover { background: var(--oxblood-dark); }
  .btn-outline { background: transparent; color: var(--oxblood); }
  .btn-outline:hover { background: var(--paper-dim); }

  .hero-photo {
    aspect-ratio: 21 / 9;
    background: linear-gradient(135deg, #7C2340 0%, #4A1526 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.75);
    text-align: center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    padding: 20px;
  }

  /* ---------- Section shell ---------- */
  section { padding: 76px 0; border-bottom: 1px solid var(--rule); }
  section:last-of-type { border-bottom: none; }
  .section-head { margin-bottom: 40px; }
  .section-head .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: var(--oxblood);
    margin-bottom: 10px;
  }
  h2 {
    font-family: 'Source Serif 4', serif;
    font-weight: 500;
    font-size: 2rem;
    margin: 0;
  }

  /* ---------- Who we are: two-column ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }
  .about-grid p { color: var(--ink-soft); margin: 0 0 18px; max-width: 48ch; }
  .about-grid p.pull {
    font-family: 'Source Serif 4', serif;
    font-size: 1.35rem;
    color: var(--ink);
    line-height: 1.4;
  }
  .stat-list { border-top: 1px solid var(--rule); }
  .stat-row {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }
  .stat-row .k { color: var(--ink-soft); font-size: 0.95rem; }
  .stat-row .v { font-family: 'IBM Plex Mono', monospace; font-weight: 500; }
  @media (max-width: 720px) { .about-grid { grid-template-columns: 1fr; gap: 34px; } }

  /* ---------- Process ---------- */
  .process { display: flex; flex-direction: column; }
  .step {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 20px;
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }
  .step:last-child { border-bottom: 1px solid var(--rule); }
  .step .n { font-family: 'IBM Plex Mono', monospace; color: var(--oxblood); font-size: 0.95rem; padding-top: 2px; }
  .step h3 { font-family: 'Source Serif 4', serif; font-size: 1.15rem; font-weight: 600; margin: 0 0 6px; }
  .step p { margin: 0; color: var(--ink-soft); max-width: 54ch; }

  /* ---------- Our Team ---------- */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 30px 22px;
  }
  .team-card { text-align: left; }
  .avatar {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper-dim);
    border: 1px solid var(--rule-dark);
    overflow: hidden;
    margin-bottom: 14px;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .team-card .name { font-family: 'Source Serif 4', serif; font-size: 1.02rem; margin-bottom: 3px; }
  .team-card .role { font-family: 'IBM Plex Mono', monospace; font-size: 0.74rem; color: var(--oxblood); margin-bottom: 10px; }
  .team-card .bio { font-size: 0.86rem; color: var(--ink-soft); line-height: 1.55; }
  .team-card .bio.muted { font-style: italic; color: var(--rule-dark); }
  @media (max-width: 900px) { .team-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }

  /* ---------- Placements ---------- */
  .placements-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .placement-cell {
    padding: 36px 16px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 180px;
    transition: background 0.15s ease;
  }
  .placement-cell:hover { background: var(--paper-dim); }
  .placement-mark {
    width: 100%;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .placement-mark img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .placement-mark .fallback {
    font-family: 'Source Serif 4', serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--oxblood);
  }
  .placement-cell .fname {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.82rem;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  @media (max-width: 860px) {
    .placements-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .placements-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ---------- Events ---------- */
  .events { display: flex; flex-direction: column; }
  .event-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding: 26px 0;
    border-top: 1px solid var(--rule);
  }
  .event-row:last-child { border-bottom: 1px solid var(--rule); }
  .event-row .date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    color: var(--oxblood);
    padding-top: 2px;
  }
  .event-row h3 { font-family: 'Source Serif 4', serif; font-size: 1.1rem; font-weight: 600; margin: 0 0 6px; }
  .event-row p { margin: 0; color: var(--ink-soft); max-width: 54ch; }
  @media (max-width: 560px) {
    .event-row { grid-template-columns: 1fr; gap: 6px; }
  }
  .join-box {
    border: 1px solid var(--oxblood);
    background: var(--paper-dim);
    padding: 48px 40px;
    text-align: center;
  }
  .join-box .eyebrow { font-family: 'IBM Plex Mono', monospace; font-size: 0.82rem; color: var(--oxblood); margin-bottom: 14px; }
  .join-box h2 { margin-bottom: 14px; }
  .join-box p { color: var(--ink-soft); max-width: 52ch; margin: 0 auto 28px; }
  .join-box .hero-actions { justify-content: center; }

  /* ---------- Footer ---------- */
  footer { padding: 44px 0 60px; }
  .foot-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 24px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
  }
  footer .brand-small { font-family: 'Source Serif 4', serif; font-size: 1.05rem; margin-bottom: 6px; }
  footer .tagline { color: var(--ink-soft); font-size: 0.9rem; max-width: 34ch; }
  .foot-links { display: flex; gap: 22px; font-family: 'IBM Plex Mono', monospace; font-size: 0.85rem; }
  .foot-links a { text-decoration: none; color: var(--ink-soft); border-bottom: 1px solid var(--rule-dark); }
  .foot-links a:hover { color: var(--oxblood); }
  .foot-bottom {
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .foot-bottom a { text-decoration: none; border-bottom: 1px solid var(--rule-dark); }

  .team-card { cursor: pointer; }
  .team-card:hover .name { color: var(--oxblood); }
  #avatar-riya img { object-position: 50% 100%; }
  .detail-avatar img.riya-photo { object-position: 50% 100%; }
  #avatar-anika img { transform: scale(1.15); }
  .detail-avatar img.anika-photo { transform: scale(1.15); }
  #avatar-angela img { transform: scale(1.05); }
  .detail-avatar img.angela-photo { transform: scale(1.05); }

  /* ---------- Member Detail ---------- */
  .member-detail { display: none; }
  .back-link {
    background: none;
    border: none;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    color: var(--oxblood);
    cursor: pointer;
    padding: 0;
    margin-bottom: 28px;
  }
  .back-link:hover { text-decoration: underline; }
  .member-detail-inner {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    align-items: start;
  }
  .detail-avatar {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--rule-dark);
    background: var(--paper-dim);
  }
  .detail-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .detail-name { font-family: 'Source Serif 4', serif; font-size: 1.5rem; margin-bottom: 6px; }
  .detail-role { font-size: 0.85rem; color: var(--oxblood); margin-bottom: 18px; }
  .detail-bio { color: var(--ink-soft); line-height: 1.65; max-width: 56ch; }
  @media (max-width: 560px) {
    .member-detail-inner { grid-template-columns: 1fr; }
    .detail-avatar { max-width: 160px; }
  }
</style>
</head>
